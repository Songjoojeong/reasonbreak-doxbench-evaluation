# Required only for OpenAI image-geolocation inference.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional: Hugging Face token if the DoxBench dataset requires authentication.
HF_TOKEN=

# Windows only: uncomment and set this if Tesseract is not on PATH.
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
